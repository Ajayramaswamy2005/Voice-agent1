DEEPGRAM_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=

# Optional overrides
# DEEPGRAM_HOST=api.in.deepgram.com   # nearest region: api.deepgram.com | api.eu | api.au | api.in
# LLM_MODEL=qwen/qwen3.8-27b        # Groq preview model; fallback: openai/gpt-oss-20b
# TURN_MODEL=qwen/qwen3.8-27b

# Which lines/*.toml to serve (comma-separated); empty = all
# ENABLED_LINES=clinic,support,browser

# Browser agent: any OpenAI-compatible endpoint with an image-capable model (default: Groq + Qwen)
# VISION_MODEL=qwen/qwen3.8-27b
# VISION_BASE_URL=
# VISION_API_KEY=
# BROWSER_HEADLESS=0                  # 0 = show the Chromium window while it works
# BROWSER_START_URL=http://localhost:8000/demo/job-application
# BROWSER_PROFILE_DIR=data/browser/profile   # saved sign-ins; "none" = fresh browser every start
# BROWSER_CDP_URL=http://localhost:9222       # drive your own Chrome (started with --remote-debugging-port=9222)
# BROWSER_ALLOWED_SITES=linkedin.com,naukri.com   # empty = any site
# BROWSER_VISION=auto                         # auto = screenshots only when needed; always = every step

# Hosting
# HOST=0.0.0.0                        # listen on all interfaces (default 127.0.0.1)
# ACCESS_CODE=                        # set to make the demo invite-only
# MAX_CALLS=3                         # concurrent calls
# MAX_CALL_SECONDS=300

# Phone (Twilio Media Streams)
# PUBLIC_URL=https://your-app.fly.dev
# TWILIO_AUTH_TOKEN=                  # set to verify Twilio's webhook signatures
